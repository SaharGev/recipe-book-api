{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": ["es2021"],
    "skipLibCheck": true
  },
  "exclude": [
    "./src/tests",
    "./client",
    "node_modules"
  ]
}